---
import { getDictionary } from "@/i18n/dictionaries";
import { buildLocalizedPath } from "@/i18n/localeRouting";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES } from "@/i18n/types";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = getDictionary(DEFAULT_LOCALE);
---

<BaseLayout
  locale={DEFAULT_LOCALE}
  title={t.app.name}
  description={t.seo.routes.home.description}
  indexable={false}
>
  <script>
    import {
      buildLocalizedPath,
      detectBrowserLocale,
    } from "@/i18n/localeRouting";

    const targetLocale = detectBrowserLocale();
    window.location.replace(
      `${buildLocalizedPath(targetLocale, "/")}${window.location.search}${window.location.hash}`,
    );
  </script>

  <noscript>
    <main style="padding: 2rem; text-align: center;">
      <p>
        {SUPPORTED_LOCALES.map((locale, index) => (
          <>
            {index > 0 ? " · " : null}
            <a href={buildLocalizedPath(locale, "/")}>
              {getDictionary(locale).preferences.languages[locale]}
            </a>
          </>
        ))}
      </p>
    </main>
  </noscript>
</BaseLayout>
