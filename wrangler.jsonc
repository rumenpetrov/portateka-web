{
  "name": "portateka-web-worker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "portateka.rpetrov.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": false,
  },
}
