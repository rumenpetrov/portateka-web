{
  "name": "portateka-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11.19.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "css:types": "vite-css-modules --silent",
    "dev": "npm run css:types && vite",
    "build": "npm run css:types && tsc -b && vite build",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "typecheck": "npm run css:types && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^7.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-css-modules": "^1.16.1",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.110.0"
  }
}
