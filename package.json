{
  "name": "portateka-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11.19.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "css:types": "vite-css-modules --silent --config vite.css.config.mjs",
    "dev": "npm run css:types && astro dev",
    "build": "npm run css:types && astro check && tsc --noEmit && astro build",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev --port 5173",
    "typecheck": "npm run css:types && astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.66.0",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^7.1.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vite-pwa/astro": "^2.0.4",
    "typescript": "^5.7.3",
    "vite-css-modules": "^1.16.1",
    "wrangler": "^4.110.0"
  }
}
